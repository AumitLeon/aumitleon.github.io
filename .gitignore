_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata

.direnv/

node_modules/
.DS_Store

# Compiled Tailwind output; generated from _styles/main.css by the tailwindcss
# CLI (dev: `make serve` / `nix run .#serve`; build: nix/site derivation).
assets/css/style.css

# Vendored front-end assets (Inter, Font Awesome, MathJax) staged into the
# working tree by `nix run .#serve` for local dev. In the real build they come
# straight from pinned Nix derivations (see flake.nix), never from git.
assets/vendor/

.bundle/
.gems/

# Nix build output symlinks (nix build -> ./result, ./result-*). They point into
# /nix/store on the building machine, so they're machine-local and never belong
# in git.
result
result-*
